<!DOCTYPE HTML>
<html lang="{{ language }}" dir="{{ direction }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }} | The V Programming Language Book</title>
    <link rel="stylesheet" href="{{ path_to_root }}css/v-dark.css">
    <link rel="stylesheet" href="{{ path_to_root }}css/general.css">
    <link rel="stylesheet" href="{{ path_to_root }}css/v-highlight.css">
    <link rel="icon" type="image/svg+xml" href="{{ path_to_root }}favicon.svg">
    {{#if print_enable}}
    <link rel="stylesheet" href="{{ path_to_root }}css/print.css">
    {{/if}}
</head>
<body>
    <div id="page-wrapper">
        <div id="page" class="page">
            <header class="v-header">
                <a href="{{ path_to_root }}" class="v-logo">
                    <span class="v-logo-text">V</span>
                    <span class="v-logo-book">Book</span>
                </a>
                <nav class="v-nav">
                    <a href="https://vlang.io">vlang.io</a>
                    <a href="https://tour.vlang.io">Tour</a>
                    <a href="https://docs.vlang.io">Docs</a>
                    <a href="https://play.vlang.io">Playground</a>
                </nav>
                <a href="https://github.com/vlang/v-book/edit/main/src/{{ path }}" class="v-edit-btn" title="Edit this page on GitHub">Edit</a>
                <div class="v-lang-selector">
                    <select id="lang-select" onchange="window.location.href=this.value">
                        <option value="{{ path_to_root }}">English</option>
                        <option value="/v-book/zh/">简体中文</option>
                        <option value="/v-book/fa/">فارسی</option>
                        <option value="/v-book/ar/">العربية</option>
                        <option value="/v-book/ru/">Русский</option>
                        <option value="/v-book/ja/">日本語</option>
                        <option value="/v-book/ko/">한국어</option>
                        <option value="/v-book/de/">Deutsch</option>
                        <option value="/v-book/fr/">Français</option>
                        <option value="/v-book/es/">Español</option>
                        <option value="/v-book/pt/">Português</option>
                        <option value="/v-book/hi/">हिन्दी</option>
                        <option value="/v-book/bn/">বাংলা</option>
                        <option value="/v-book/ur/">اردو</option>
                        <option value="/v-book/id/">Bahasa Indonesia</option>
                        <option value="/v-book/tr/">Türkçe</option>
                    </select>
                </div>
            </header>
            {{{ content }}}
            <footer class="v-footer">
                <p>The V Programming Language Book is a community project. <a href="https://github.com/vlang/v-book">Contribute on GitHub</a>.</p>
            </footer>
        </div>
    </div>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
    <script src="{{ path_to_root }}js/v-highlight.js"></script>
    <script>
        hljs.highlightAll();
        document.getElementById('lang-select').addEventListener('change', function() {
            const currentPath = window.location.pathname;
            const currentDir = currentPath.substring(currentPath.indexOf('/', 1) + 1);
            const pagePath = currentDir.includes('/') ? currentDir.split('/').slice(1).join('/') + '.html' : '';
            window.location.href = this.value + pagePath;
        });
    </script>
</body>
</html>
