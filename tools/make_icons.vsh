module main

import os
import compress.zlib

// Icon generator for the book's progressive web app.
//
// The book is generated by V, so its icons are too: the V mark is two
// parallelograms, the same two the header's logo.svg draws, rasterised here at
// the sizes a manifest asks for, plus a 1200x630 social card. Run:
//
//	v run tools/make_icons.vsh
const out_dir = 'static'

// Rgba is one pixel of the canvas.
struct Rgba {
mut:
	canvas [][]u8
}

fn new_canvas(w int, h int) Rgba {
	mut canvas := [][]u8{cap: h}
	for _ in 0 .. h {
		// Four bytes per pixel: red, green, blue and alpha.
		canvas << []u8{len: w * 4, init: 0}
	}
	return Rgba{
		canvas: canvas
	}
}

fn (mut c Rgba) set(x int, y int, r u8, g u8, b u8, a u8) {
	if x < 0 || y < 0 || y >= c.canvas.len {
		return
	}
	at := x * 4 + 3
	if at >= c.canvas[y].len {
		return
	}
	c.canvas[y][x * 4] = r
	c.canvas[y][x * 4 + 1] = g
	c.canvas[y][x * 4 + 2] = b
	c.canvas[y][x * 4 + 3] = a
}

fn (mut c Rgba) fill_rect(x int, y int, w int, h int, col []u8) {
	for py in y .. y + h {
		for px in x .. x + w {
			c.set(px, py, col[0], col[1], col[2], col[3])
		}
	}
}

fn (mut c Rgba) fill_polygon(points [][]f64, col []u8) {
	// Scanline fill: for each row, collect the edges the row crosses.
	mut min_y := 1 << 30
	mut max_y := -(1 << 30)
	for p in points {
		if int(p[1]) < min_y {
			min_y = int(p[1])
		}
		if int(p[1]) > max_y {
			max_y = int(p[1])
		}
	}
	for py in min_y .. max_y + 1 {
		mut xs := []f64{}
		for i in 0 .. points.len {
			a := points[i]
			b := points[(i + 1) % points.len]
			if (a[1] <= py && b[1] > py) || (b[1] <= py && a[1] > py) {
				xs << a[0] + (py - a[1]) / (b[1] - a[1]) * (b[0] - a[0])
			}
		}
		xs.sort()
		// Each row crosses every edge twice, so the spans are walked in pairs.
		mut i := 0
		for i + 1 < xs.len {
			from := int(xs[i] + 0.5)
			to := int(xs[i + 1] + 0.5)
			for px in from .. to {
				c.set(px, py, col[0], col[1], col[2], col[3])
			}
			i += 2
		}
	}
}

// v_mark draws the V logo's two strokes scaled into the box at (x, y, size).
// The shapes follow logo.svg: a lighter left stroke and a slate right stroke
// with the notch cut from the top.
fn (mut c Rgba) v_mark(x int, y int, size f64) {
	s := size / 32.0
	left := [
		[1.66 * s, 1.2 * s],
		[10.68 * s, 1.2 * s],
		[20.478 * s, 30.371 * s],
		[11.722 * s, 29.935 * s],
	]
	right := [
		[20.786 * s, 30.237 * s],
		[30.948 * s, 1.978 * s],
		[21.948 * s, 1.198 * s],
		[12.35 * s, 1.968 * s],
	]
	mut lp := [][]f64{}
	for p in left {
		lp << [p[0] + x, p[1] + y]
	}
	mut rp := [][]f64{}
	for p in right {
		rp << [p[0] + x, p[1] + y]
	}
	c.fill_polygon(lp, [u8(0x5d), 0x87, 0xbf, 0xff])
	c.fill_polygon(rp, [u8(0x53), 0x6b, 0x8a, 0xff])
}

// bytes builds a PNG from an RGBA canvas. Each scanline uses filter 0, and the
// image data goes through zlib, the same compression the format specifies.
fn (c Rgba) bytes() ![]u8 {
	w := if c.canvas.len > 0 { c.canvas[0].len / 4 } else { 0 }
	h := c.canvas.len
	mut raw := []u8{cap: h * (w * 4 + 1)}
	for y in 0 .. h {
		raw << u8(0)
		raw << c.canvas[y]
	}
	compressed := zlib.compress(raw)!
	mut out := []u8{cap: compressed.len + 64}
	out << [u8(0x89), `P`, `N`, `G`, `\r`, `\n`, 0x1a, `\n`]
	ihdr := make_ihdr(w, h)
	out << chunk('IHDR', ihdr)
	out << chunk('IDAT', compressed)
	out << chunk('IEND', [])
	return out
}

fn make_ihdr(w int, h int) []u8 {
	return [
		u8(w >> 24),
		u8(w >> 16),
		u8(w >> 8),
		u8(w),
		u8(h >> 24),
		u8(h >> 16),
		u8(h >> 8),
		u8(h),
		8, // bit depth
		6, // colour type: truecolour with alpha
		0, // deflate
		0, // adaptive filtering
		0,
	]
}

// chunk wraps PNG data in its length, type, payload and CRC32.
fn chunk(kind string, data []u8) []u8 {
	mut out := []u8{cap: data.len + 12}
	out << [u8(data.len >> 24), u8(data.len >> 16), u8(data.len >> 8), u8(data.len)]
	mut typed := []u8{cap: kind.len + data.len}
	for c in kind {
		typed << u8(c)
	}
	typed << data
	out << typed
	crc := crc32(typed)
	out << [u8(crc >> 24), u8(crc >> 16), u8(crc >> 8), u8(crc)]
	return out
}

// crc32 is the PNG checksum: the standard Ethernet polynomial over the typed
// data, seeded and finalised the way the format requires.
fn crc32(data []u8) u32 {
	mut crc := u32(0xffffffff)
	for b in data {
		crc ^= u32(b)
		for _ in 0 .. 8 {
			mask := u32(0xedb88320) & (u32(0) - (crc & 1))
			crc = (crc >> 1) ^ mask
		}
	}
	return crc ^ 0xffffffff
}

// save writes the canvas as a PNG at path.
fn (c Rgba) save(path string) ! {
	os.write_file(path, c.bytes()!.bytestr())!
}

fn main() {
	// Icons: a rounded navy tile with the V mark centred, at the two sizes a
	// manifest asks for.
	for size in [192, 512] {
		mut c := new_canvas(size, size)
		c.fill_rect(0, 0, size, size, [u8(0x0b), 0x12, 0x30, 0xff])
		mark := size * 3 / 4
		c.v_mark((size - mark) / 2, (size - mark) / 2, mark)
		c.save('${out_dir}/icon-${size}.png') or { panic(err) }
		println('wrote ${out_dir}/icon-${size}.png')
	}
	// The social card: navy, the mark top left, and a lighter band the bottom
	// so a shared link does not look like an empty rectangle.
	mut card := new_canvas(1200, 630)
	card.fill_rect(0, 0, 1200, 630, [u8(0x0b), 0x12, 0x30, 0xff])
	card.fill_rect(0, 470, 1200, 160, [u8(0x1a), 0x28, 0x55, 0xff])
	card.v_mark(96, 96, 240)
	card.save('${out_dir}/og-image.png') or { panic(err) }
	println('wrote ${out_dir}/og-image.png')
}
